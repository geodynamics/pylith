{
    "editor.formatOnSave": true,
    "telemetry.enableTelemetry": false,
    "telemetry.enableCrashReporter": false,
    "files.associations": {
        "*.icc": "cpp",
    },
    "testMate.cpp.test.advancedExecutables": [
        {
            "name": "${filename}",
            "pattern": "${os_env:PYLITH_BUILDDIR}/tests/libtests/**/.libs/libtest_*",
            "cwd": "${absDirpath}/.."
        },
        {
            "name": "${filename}",
            "pattern": "${os_env:PYLITH_BUILDDIR}/tests/mmstests/**/.libs/mmstest_*",
            "cwd": "${absDirpath}/.."
        }
    ],
    "cSpell.words": [
        "Aagaard",
        "aprepro",
        "automake",
        "autotools",
        "cuda",
        "deviatoric",
        "discretization",
        "dm",
        "drucker",
        "elastoplastic",
        "Gmsh",
        "Knepley",
        "neumann",
        "nodeset",
        "partitioner",
        "petsc",
        "plex",
        "pointwise",
        "prager",
        "preconditioner",
        "prestep",
        "pset",
        "pylith",
        "raphson",
        "scec",
        "snes",
        "spatialdata",
        "spatialdb",
        "trelis",
        "viscoelastic",
        "xdmf"
    ],
    "C_Cpp.default.cppStandard": "c++14",
    "C_Cpp.default.cStandard": "c11",
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 100,
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "black-formatter.args": [
        "--line-length",
        "120"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file"
}