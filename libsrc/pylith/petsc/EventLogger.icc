#pragma once

// Set name of logging class.
inline void
pylith::petsc::EventLogger::setClassName(const char* name) {
    _className = name;
}


// Get name of logging class.
inline const char*
pylith::petsc::EventLogger::getClassName(void) const {
    return _className.c_str();
}


// Scope constructor logs event begin.
inline pylith::petsc::EventLogger::Scope::Scope(const PetscLogEvent event) : _event(event) {
    PetscLogEventBegin(_event, 0, 0, 0, 0);
}

// Scope destructor logs event end.
inline pylith::petsc::EventLogger::Scope::~Scope(void) {
    PetscLogEventEnd(_event, 0, 0, 0, 0);
}


// Log stage begin.
inline void
pylith::petsc::EventLogger::stagePush(const PetscLogStage id) {
    PetscLogStagePush(id);
} // stagePush


// Log stage end.
inline void
pylith::petsc::EventLogger::stagePop(void) {
    PetscLogStagePop();
} // stagePop


// End of file
