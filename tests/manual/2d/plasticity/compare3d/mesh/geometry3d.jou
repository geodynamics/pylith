# ----------------------------------------------------------------------
# Create block
# ----------------------------------------------------------------------

# Block is 4 m x 2 m x 0.2 m
# -2 m <= x <= 2 m
# -1 m <= y <= 1 m
# -0.2 m <= z <= 0.2 m
reset
brick x 4 y 2 z 0.2


# End of file
